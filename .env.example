# Dropbox API credentials — see README.md "Setup" and "Credential rotation"
# sections for how to obtain these from the Dropbox App Console under the
# company Dropbox account.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Where the app looks for the Active/Inactive/Historicals/Needs Review
# folders. Use the Dev Sandbox paths below during development; switch to
# the real paths (e.g. /Shared/Active) only when ready to go live.
DROPBOX_ACTIVE_PATH=/Shared/Dev Sandbox/Active
DROPBOX_INACTIVE_PATH=/Shared/Dev Sandbox/Inactive
DROPBOX_HISTORICALS_PATH=/Shared/Dev Sandbox/Historicals
DROPBOX_NEEDS_REVIEW_PATH=/Shared/Dev Sandbox/Needs Review

# Comma-separated list of origins allowed to call the backend API.
BACKEND_CORS_ORIGINS=http://localhost:5173

# Not needed for local dev — api.js defaults to the relative "/api",
# proxied to the backend by Vite's dev server (see vite.config.js) so the
# session cookie stays same-site. Only set this to override that default.
# VITE_API_BASE_URL=

# Per-user Dropbox sign-in (distinct from DROPBOX_REFRESH_TOKEN above,
# which is the one fixed service account every ticker/file operation
# still runs as — this is purely for verifying who's allowed to use the
# app at all). DROPBOX_REDIRECT_URI must be added to this Dropbox app's
# allowed OAuth redirect URIs in the Dropbox App Console, or sign-in will
# be rejected server-side before it ever reaches this app. Points at the
# frontend's own /api/auth/callback (proxied through to the backend), not
# the backend directly — a cross-site redirect_uri here would make the
# session cookie cross-site too, which Firefox's Total Cookie Protection
# silently blocks. See README.md "Firefox sign-in" for the full story.
DROPBOX_REDIRECT_URI=http://localhost:5173/api/auth/callback
FRONTEND_URL=http://localhost:5173

# Signs the session cookie — generate one with `python3 -c "import
# secrets; print(secrets.token_hex(32))"`. Changing this logs everyone
# out. Never commit the real value.
SESSION_SECRET_KEY=

# Where the activity-log SQLite file lives. A relative path (the default)
# resolves inside the backend folder — fine for local dev, but in
# production this MUST point at a mounted Railway Volume (e.g. /data/
# activity.db), or the whole audit trail resets on every redeploy. See
# README.md "Redeploying".
ACTIVITY_DB_PATH=data/activity.db

# Optional — used to look up each ticker's company logo (see
# backend/app/services/logos.py), shown on its folder card in place of the
# generic folder icon when found. Free-tier Logo.dev publishable key
# (https://www.logo.dev). Leave blank to skip logos entirely and always
# show the plain folder icon.
LOGO_DEV_API_KEY=

# ChatGPT<->Claude research-report "bridge" (see backend/app/routers/
# bridge.py) — the user adds a custom MCP connector in each app pointing at
# https://<backend-domain>/bridge/<secret>/mcp, one secret per AI. Each
# secret IS the entire auth boundary (no header-based auth works
# reliably from ChatGPT's connector UI) — generate each with
# `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`, long
# and random, never committed. Leaving either blank simply skips mounting
# that AI's bridge route (both are optional for local dev).
BRIDGE_CHATGPT_SECRET=
BRIDGE_CLAUDE_SECRET=

# Optional — emails the user a one-line heads-up whenever a new bridge
# message shows up, so he doesn't have to remember to check (see
# backend/app/services/notifications.py). Sent via plain SMTP with a
# Gmail app password (not the account's real password — generate one at
# https://myaccount.google.com/apppasswords). Leaving BRIDGE_NOTIFY_EMAIL
# blank disables the whole notification loop.
BRIDGE_NOTIFY_EMAIL=
BRIDGE_NOTIFY_SMTP_USER=
BRIDGE_NOTIFY_SMTP_APP_PASSWORD=
BRIDGE_NOTIFY_INTERVAL_SECONDS=300

# Optional — lets the user forward an email straight into a ticker's Dropbox
# folder (see backend/app/routers/email_intake.py). Mailgun receives the
# forwarded email at intake+TICKER@<MAILGUN_INBOUND_DOMAIN> and POSTs it
# to this app's /email-intake/inbound webhook. MAILGUN_WEBHOOK_SIGNING_KEY
# is the account's own signing key (Mailgun dashboard: Settings ->
# Security), used to verify a webhook POST actually came from Mailgun
# before ever touching Dropbox. Leaving it blank skips mounting the
# intake route entirely.
MAILGUN_WEBHOOK_SIGNING_KEY=
MAILGUN_INBOUND_DOMAIN=
