# Dropbox API credentials — see README.md "Setup" and "Credential rotation"
# sections for how to obtain these from the Dropbox App Console under the
# company Dropbox account.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Where the app looks for the Active/Inactive/Historicals/Needs Review
# folders. Use the Dev Sandbox paths below during development; switch to
# the real paths (e.g. /Shared/Active) only when ready to go live.
DROPBOX_ACTIVE_PATH=/Shared/Dev Sandbox/Active
DROPBOX_INACTIVE_PATH=/Shared/Dev Sandbox/Inactive
DROPBOX_HISTORICALS_PATH=/Shared/Dev Sandbox/Historicals
DROPBOX_NEEDS_REVIEW_PATH=/Shared/Dev Sandbox/Needs Review

# Comma-separated list of origins allowed to call the backend API.
BACKEND_CORS_ORIGINS=http://localhost:5173

# Base URL the frontend uses to reach the backend. Must be prefixed with
# VITE_ so Vite exposes it to client-side code.
VITE_API_BASE_URL=http://localhost:8000

# Per-user Dropbox sign-in (distinct from DROPBOX_REFRESH_TOKEN above,
# which is the one fixed service account every ticker/file operation
# still runs as — this is purely for verifying who's allowed to use the
# app at all). DROPBOX_REDIRECT_URI must be added to this Dropbox app's
# allowed OAuth redirect URIs in the Dropbox App Console, or sign-in will
# be rejected server-side before it ever reaches this app.
DROPBOX_REDIRECT_URI=http://localhost:8000/auth/callback
FRONTEND_URL=http://localhost:5173

# Signs the session cookie — generate one with `python3 -c "import
# secrets; print(secrets.token_hex(32))"`. Changing this logs everyone
# out. Never commit the real value.
SESSION_SECRET_KEY=

# Where the activity-log SQLite file lives. A relative path (the default)
# resolves inside the backend folder — fine for local dev, but in
# production this MUST point at a mounted Railway Volume (e.g. /data/
# activity.db), or the whole audit trail resets on every redeploy. See
# README.md "Redeploying".
ACTIVITY_DB_PATH=data/activity.db
