# Dropbox API credentials — see README.md "Setup" and "Credential rotation"
# sections for how to obtain these from the Dropbox App Console under the
# company Dropbox account.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Where the app looks for the Active/Inactive/Historicals/Needs Review
# folders. Use the Dev Sandbox paths below during development; switch to
# the real paths (e.g. /Shared/Active) only when ready to go live.
DROPBOX_ACTIVE_PATH=/Shared/Dev Sandbox/Active
DROPBOX_INACTIVE_PATH=/Shared/Dev Sandbox/Inactive
DROPBOX_HISTORICALS_PATH=/Shared/Dev Sandbox/Historicals
DROPBOX_NEEDS_REVIEW_PATH=/Shared/Dev Sandbox/Needs Review

# Comma-separated list of origins allowed to call the backend API.
BACKEND_CORS_ORIGINS=http://localhost:5173

# Base URL the frontend uses to reach the backend. Must be prefixed with
# VITE_ so Vite exposes it to client-side code.
VITE_API_BASE_URL=http://localhost:8000
